// ==========================================
// CONFIGURACIÓN DE PRISMA Y BASE DE DATOS
// ==========================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum EstadoPagoMatricula {
  PENDIENTE_SUBIDA      // Recién matriculado: ID y clave activos para subir el voucher
  EN_REVISION           // Voucher subido: ID cerrado mientras administración verifica
  OBSERVADO_RECHAZADO   // Rechazado: habilitado por 48h mostrando motivo del admin
  CONFIRMADO            // Aprobado: muestra directamente el mensaje de aprobación
  COMPLETADO            // Trámite cerrado definitivamente
}

// ==========================================
// MODELOS
// ==========================================

model MensajeContacto {
  id       String   @id @default(uuid())
  dni      String
  nombre   String
  telefono String
  asunto   String
  fecha    DateTime @default(now())
}

model Usuario {
  id       Int    @id @default(autoincrement())
  usuario  String
  password String
  dni      String @unique
}

model Galeria {
  id         Int      @id @default(autoincrement())
  src        String   @db.Text
  alt        String
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("galeria")
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String?
  descripcion String?  @db.Text
  src         String   @db.Text
  alt         String
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  order       Int      @default(0) @map("order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("eventos")
}

model Video {
  id         Int      @id @default(autoincrement())
  src        String   @db.Text
  alt        String
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("videos")
}

model Hero {
  id         Int      @id @default(autoincrement())
  title      String?  @db.Text
  imageUrl   String   @db.Text @map("image_url")
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("hero")
}

model AdmisionConfig {
  id          String   @id @default(uuid())
  year        String
  badgeText   String   @default("MATRICULAS")
  title       String   @default("MATRICULAS ABIERTAS")
  description String   @default("Quiero empezar la matricula y conocer los requisitos del proceso.")
  buttonText  String   @default("Ver pasos y requisitos")
  linkUrl     String   @default("/matricula")
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model MatriculaInscripcion {
  id                  Int            @id @default(autoincrement())
  anioEscolar         String         @default("2026") @map("anio_escolar")
  sede                String         @default("Colegio Cayros")
  nombresEstudiante   String
  apellidosEstudiante String
  dniEstudiante       String
  nivel               String
  grado               String
  nombresApoderado    String
  telefono            String
  email               String?
  mensaje             String?
  tieneOpcion         String?
  detalleOpcion       String?
  createdAt           DateTime       @default(now())
  pagoMatricula       PagoMatricula?
}

model PagoMatricula {
  id                 Int                  @id @default(autoincrement())
  codigoPago         String               @unique @map("codigo_pago")
  passwordPago       String               @map("password_pago")
  estado             EstadoPagoMatricula  @default(PENDIENTE_SUBIDA)
  accesoHabilitado   Boolean              @default(true) @map("acceso_habilitado")
  habilitadoHasta    DateTime?            @map("habilitado_hasta")
  voucherUrl         String?              @db.Text @map("voucher_url")
  numeroOperacion    String?              @unique @map("numero_operacion")
  bancoOrigen        String?              @map("banco_origen")
  montoPagado        Decimal?             @db.Decimal(10, 2) @map("monto_pagado")
  fechaSubidaVoucher DateTime?            @map("fecha_subida_voucher")
  mensajeAdmin       String?              @db.Text @map("mensaje_admin")
  revisadoPor        String?              @map("revisado_por")
  fechaRevision      DateTime?            @map("fecha_revision")
  cerradoEn          DateTime?            @map("cerrado_en")
  matriculaId        Int                  @unique @map("matricula_id")
  matricula          MatriculaInscripcion @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@map("pagos_matricula")
}

model MatriculaGaleria {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ConfiguracionHome {
  id                Int @id @default(1)
  limiteGaleriaHome Int @default(6) @map("limite_galeria_home")
  limiteEventosHome Int @default(3) @map("limite_eventos_home")

  @@map("configuracion_home")
}

// ==========================================
//  COMANDOS ÚTILES DE PRISMA (REFERENCIA)
// ==========================================
// 
// 1. Crear y aplicar una migración (cada vez que cambies el schema):
//    npx prisma migrate dev --name nombre_de_la_migracion
//
// 2. Abrir Prisma Studio (interfaz gráfica web para ver tus datos en local):
//    npx prisma studio
//
// 3. Sincronizar la base de datos sin crear archivos de migración (solo desarrollo rápido):
//    npx prisma db push
//
// 4. Regenerar el cliente de Prisma (si actualizas el schema y Node da error de tipos):
//    npx prisma generate
//    npx prisma db seed