// ==========================================
// CONFIGURACIÓN DE PRISMA Y BASE DE DATOS
// ==========================================


datasource db {
  provider = "postgresql"
}


generator client {
  provider = "prisma-client-js"
}


model MensajeContacto {
  id       String   @id @default(uuid())
  dni      String
  nombre   String
  telefono String
  asunto   String
  fecha    DateTime @default(now())
}


model Usuario {
  id       Int    @id @default(autoincrement())
  usuario  String
  password String
  dni      String @unique
}


model Galeria {
  id         Int      @id @default(autoincrement())
  src        String   @db.Text
  alt        String
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("galeria")
}


model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String?
  descripcion String?  @db.Text
  src         String   @db.Text
  alt         String
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  order       Int      @default(0) @map("order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("eventos")
}


model Video {
  id         Int      @id @default(autoincrement())
  src        String   @db.Text
  alt        String
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("videos")
}


model Hero {
  id           Int      @id @default(autoincrement())
  title        String?  @db.Text // Título de referencia interna (opcional)
  imageUrl     String   @db.Text @map("image_url")
  isActive     Boolean  @default(true) @map("is_active")
  isFeatured   Boolean  @default(false) @map("is_featured")
  order        Int      @default(0) @map("order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("hero")
}

model AdmisionConfig {
  id          String   @id @default(uuid())
  year        String   // Ej: "2026", "2027", etc. Administrable en el Panel
  badgeText   String   @default("MATRICULAS")
  title       String   @default("MATRICULAS ABIERTAS")
  description String   @default("Quiero empezar la matricula y conocer los requisitos del proceso.")
  buttonText  String   @default("Ver pasos y requisitos")
  linkUrl     String   @default("/matricula")
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model MatriculaInscripcion {
  id          Int      @id @default(autoincrement())
  nombresEstudiante String
  apellidosEstudiante String
  nivel       String   // Inicial, Primaria, Secundaria
  grado       String
  nombresApoderado String
  telefono    String
  email       String?
  mensaje     String?
  createdAt   DateTime @default(now())
}
model MatriculaGaleria {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}


// Tabla para almacenar parámetros globales de la Home (Límites, preferencias, etc.)
model ConfiguracionHome {
  id                Int @id @default(1)
  limiteGaleriaHome Int @default(6) @map("limite_galeria_home")
  limiteEventosHome Int @default(3) @map("limite_eventos_home")

  @@map("configuracion_home")
}

// ==========================================
//  COMANDOS ÚTILES DE PRISMA (REFERENCIA)
// ==========================================
// 
// 1. Crear y aplicar una migración (cada vez que cambies el schema):
//    npx prisma migrate dev --name nombre_de_la_migracion
//
// 2. Abrir Prisma Studio (interfaz gráfica web para ver tus datos en local):
//    npx prisma studio
//
// 3. Sincronizar la base de datos sin crear archivos de migración (solo desarrollo rápido):
//    npx prisma db push
//
// 4. Regenerar el cliente de Prisma (si actualizas el schema y Node da error de tipos):
//    npx prisma generate
//    npx prisma db seed