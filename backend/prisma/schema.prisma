// ==========================================
// CONFIGURACIÓN DE PRISMA Y BASE DE DATOS
// ==========================================


datasource db {
  provider = "postgresql"
}


generator client {
  provider = "prisma-client-js"
}


model MensajeContacto {
  id       String   @id @default(uuid())
  dni      String
  nombre   String
  telefono String
  asunto   String
  fecha    DateTime @default(now())
}


model Usuario {
  id       Int    @id @default(autoincrement())
  usuario  String
  password String
  dni      String @unique
}


model Galeria {
  id         Int      @id @default(autoincrement())
  src        String   @db.Text
  alt        String
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("galeria")
}


model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String?
  descripcion String?  @db.Text
  src         String   @db.Text
  alt         String
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  order       Int      @default(0) @map("order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("eventos")
}


model Video {
  id         Int      @id @default(autoincrement())
  src        String   @db.Text
  alt        String
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("videos")
}


model HeroSlide {
  id          Int      @id @default(autoincrement())
  badgeText   String?  @map("badge_text")
  title       String   @db.Text
  subtitle    String?  @db.Text
  quote       String?  @db.Text
  description String?  @db.Text
  buttonText  String?  @default("CONTÁCTANOS") @map("button_text")
  buttonUrl   String?  @default("#contacto") @map("button_url")
  imageUrl    String   @db.Text @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0) @map("order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("hero_slides")
}


// Tabla para almacenar parámetros globales de la Home (Límites, preferencias, etc.)
model ConfiguracionHome {
  id                Int @id @default(1)
  limiteGaleriaHome Int @default(6) @map("limite_galeria_home")
  limiteEventosHome Int @default(3) @map("limite_eventos_home")

  @@map("configuracion_home")
}

// ==========================================
//  COMANDOS ÚTILES DE PRISMA (REFERENCIA)
// ==========================================
// 
// 1. Crear y aplicar una migración (cada vez que cambies el schema):
//    npx prisma migrate dev --name nombre_de_la_migracion
//
// 2. Abrir Prisma Studio (interfaz gráfica web para ver tus datos en local):
//    npx prisma studio
//
// 3. Sincronizar la base de datos sin crear archivos de migración (solo desarrollo rápido):
//    npx prisma db push
//
// 4. Regenerar el cliente de Prisma (si actualizas el schema y Node da error de tipos):
//    npx prisma generate